<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>random12</title>
    <style>
        :root {
            --bg-color: #f8fafc;
            --text-color: #1e293b;
            --grid-bg: #ffffff;
            --border-color: #e2e8f0;
            --primary: #3b82f6;
            --primary-hover: #2563eb;
            --secondary-bg: #e2e8f0;
            --secondary-hover: #cbd5e1;
            --secondary-text: #334155;
        }

        /* Dark mode support */
        @media (prefers-color-scheme: dark) {
            :root {
                --bg-color: #0f172a;
                --text-color: #f8fafc;
                --grid-bg: #1e293b;
                --border-color: #334155;
                --secondary-bg: #334155;
                --secondary-hover: #475569;
                --secondary-text: #f8fafc;
            }
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }

        .container {
            max-width: 700px;
            width: 100%;
        }

        .header-section {
            text-align: center;
            margin-bottom: 30px;
        }

        h1 {
            margin-top: 0;
            font-weight: 700;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        }

        .controls {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            gap: 16px;
        }

        .buttons-group {
            display: flex;
            gap: 12px;
        }

        .radio-group {
            display: flex;
            gap: 16px;
            background-color: var(--grid-bg);
            padding: 12px 16px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }

        .radio-group label {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            font-size: 1.1rem;
            user-select: none;
        }

        .more-options-panel {
            background-color: var(--grid-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 24px;
            display: none;
        }

        .more-options-panel.open {
            display: block;
        }

        .options-title {
            font-weight: 600;
            margin-bottom: 12px;
            font-size: 1.05rem;
        }

        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .checkbox-group label {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            user-select: none;
            background-color: var(--bg-color);
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            font-size: 0.95rem;
            transition: border-color 0.2s;
        }

        .checkbox-group label:hover {
            border-color: var(--primary);
        }

        button {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 14px 28px;
            border-radius: 8px;
            font-size: 1.1rem;
            cursor: pointer;
            font-weight: 600;
            transition: background-color 0.2s;
            box-shadow: 0 2px 4px rgba(59, 130, 246, 0.3);
        }

        button:hover {
            background-color: var(--primary-hover);
        }

        button.secondary-btn {
            background-color: var(--secondary-bg);
            color: var(--secondary-text);
            box-shadow: none;
        }

        button.secondary-btn:hover {
            background-color: var(--secondary-hover);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            background-color: var(--grid-bg);
            padding: 24px;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            border: 1px solid var(--border-color);
        }

        .note {
            display: flex;
            align-items: center;
            justify-content: center;
            aspect-ratio: 1;
            min-width: 0;
            min-height: 0;
            font-size: 2.2rem;
            font-weight: 700;
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            transition: transform 0.1s ease-in-out;
            text-align: center;
            flex-direction: row;
            line-height: 1.1;
        }

        .chord-suffix {
            font-size: 1.1rem;
            font-weight: 500;
            opacity: 0.8;
            margin-left: 2px;
        }

        .note:active {
            transform: scale(0.95);
        }

        @media (max-width: 500px) {
            .grid {
                gap: 8px;
                padding: 12px;
            }

            .note {
                font-size: 1.3rem;
                border-radius: 6px;
            }

            .chord-suffix {
                font-size: 0.8rem;
                margin-left: 1px;
            }

            .controls {
                flex-direction: column;
                align-items: stretch;
            }

            .buttons-group {
                flex-direction: column;
            }

            .radio-group {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            h1 {
                font-size: 1.5rem;
                margin-bottom: 10px;
            }
        }
    </style>
</head>

<body>

    <div class="container">
        <div class="header-section">
            <h1>random12</h1>
        </div>

        <div class="controls">
            <div class="radio-group">
                <label>
                    <input type="radio" name="accidental" value="flats" checked> Flats (♭)
                </label>
                <label>
                    <input type="radio" name="accidental" value="sharps"> Sharps (♯)
                </label>
                <label>
                    <input type="radio" name="accidental" value="random"> Random
                </label>
            </div>
            <div class="buttons-group">
                <button class="secondary-btn" id="toggle-options-btn" onclick="toggleOptions()">More Options</button>
                <button onclick="generateNotes()">Re-randomise</button>
            </div>
        </div>

        <div class="more-options-panel" id="more-options-panel">
            <div class="options-title">Include Random Chords:</div>
            <div class="checkbox-group" id="chord-checkboxes">
                <label><input type="checkbox" value="maj"> Major</label>
                <label><input type="checkbox" value="m"> Minor</label>
                <label><input type="checkbox" value="maj7"> Major 7</label>
                <label><input type="checkbox" value="m7"> Minor 7</label>
                <label><input type="checkbox" value="7"> Dominant 7</label>
                <label><input type="checkbox" value="m7♭5"> Half Dim (m7♭5)</label>
                <label><input type="checkbox" value="dim"> Diminished</label>
                <label><input type="checkbox" value="aug"> Augmented</label>
            </div>
        </div>

        <div class="grid" id="grid">
            <!-- Notes will be inserted here -->
        </div>
    </div>

    <script>
        const notesFlats = ["C", "D♭", "D", "E♭", "E", "F", "G♭", "G", "A♭", "A", "B♭", "B"];
        const notesSharps = ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"];

        function toggleOptions() {
            const panel = document.getElementById("more-options-panel");
            const btn = document.getElementById("toggle-options-btn");
            if (panel.classList.contains("open")) {
                panel.classList.remove("open");
                btn.textContent = "More Options";
            } else {
                panel.classList.add("open");
                btn.textContent = "Hide Options";
            }
        }

        function loadState() {
            let hash = window.location.hash.substring(1);
            if (hash) {
                const parts = hash.split(',');
                parts.forEach(p => {
                    const clean = p.trim().toLowerCase();
                    if (['flats', 'sharps', 'random'].includes(clean)) {
                        const rb = document.querySelector(`input[name="accidental"][value="${clean}"]`);
                        if (rb) rb.checked = true;
                    } else {
                        const cbs = document.querySelectorAll('#chord-checkboxes input');
                        cbs.forEach(cb => {
                            if (cb.value === p.trim()) {
                                cb.checked = true;
                                document.getElementById("more-options-panel").classList.add("open");
                                document.getElementById("toggle-options-btn").textContent = "Hide Options";
                            }
                        });
                    }
                });
            } else {
                const savedAccidental = localStorage.getItem('random12_accidental');
                if (savedAccidental) {
                    const rb = document.querySelector(`input[name="accidental"][value="${savedAccidental}"]`);
                    if (rb) rb.checked = true;
                }

                const savedChords = localStorage.getItem('random12_chords');
                if (savedChords) {
                    try {
                        const chords = JSON.parse(savedChords);
                        if (chords && chords.length > 0) {
                            chords.forEach(c => {
                                const cbs = document.querySelectorAll('#chord-checkboxes input');
                                cbs.forEach(cb => {
                                    if (cb.value === c) cb.checked = true;
                                });
                            });
                            document.getElementById("more-options-panel").classList.add("open");
                            document.getElementById("toggle-options-btn").textContent = "Hide Options";
                        }
                    } catch (e) { }
                }
            }
        }

        function saveState() {
            const mode = document.querySelector('input[name="accidental"]:checked').value;
            localStorage.setItem('random12_accidental', mode);

            const chordCheckboxes = document.querySelectorAll('#chord-checkboxes input:checked');
            const selectedChords = Array.from(chordCheckboxes).map(cb => cb.value);
            localStorage.setItem('random12_chords', JSON.stringify(selectedChords));

            const hashParts = [mode, ...selectedChords];
            history.replaceState(null, null, '#' + hashParts.join(','));
        }

        function shuffle(array) {
            let currentIndex = array.length, randomIndex;
            while (currentIndex !== 0) {
                randomIndex = Math.floor(Math.random() * currentIndex);
                currentIndex--;
                [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
            }
            return array;
        }

        function generateNotes() {
            const mode = document.querySelector('input[name="accidental"]:checked').value;
            const grid = document.getElementById("grid");

            // Get selected chords
            const chordCheckboxes = document.querySelectorAll('#chord-checkboxes input:checked');
            const selectedChords = Array.from(chordCheckboxes).map(cb => cb.value);

            let selectedNotes = [];
            for (let i = 0; i < 12; i++) {
                let note = "";
                if (mode === "flats") {
                    note = notesFlats[i];
                } else if (mode === "sharps") {
                    note = notesSharps[i];
                } else {
                    note = Math.random() < 0.5 ? notesFlats[i] : notesSharps[i];
                }

                let suffix = "";
                if (selectedChords.length > 0) {
                    suffix = selectedChords[Math.floor(Math.random() * selectedChords.length)];
                }

                selectedNotes.push({ note, suffix });
            }

            const shuffledNotes = shuffle(selectedNotes);

            grid.innerHTML = "";
            shuffledNotes.forEach(item => {
                const div = document.createElement("div");
                div.className = "note";

                // If there's a suffix, show it next to the note root
                if (item.suffix) {
                    div.innerHTML = `<span>${item.note}</span><span class="chord-suffix">${item.suffix}</span>`;
                } else {
                    div.textContent = item.note;
                }

                grid.appendChild(div);
            });

            saveState();
        }

        // Re-generate when radio or checkboxes change
        document.querySelectorAll('input[name="accidental"], #chord-checkboxes input').forEach(input => {
            input.addEventListener('change', generateNotes);
        });

        // Add hashchange listener
        window.addEventListener('hashchange', () => {
            // Only load state if hash changed externally
            loadState();
            generateNotes();
        });

        // Initial generation
        loadState();
        generateNotes();
    </script>

</body>

</html>